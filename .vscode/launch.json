{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Edge",
			"request": "launch",
			"type": "msedge",
			"url": "${fileDirname}/${fileBasename}",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Python Localhost",
