{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Python Localhost",
			"type": "shell",
			"command": "python",
			"args": [
				"-m","http.server","8000"
			],
			"isBackground": true,
			"problemMatcher":{
				"owner": "Host",
				"fileLocation": [
					"autoDetect",
					"${workspaceRoot}"
				],
				"pattern": {
					"regexp": "(warning|error)\\s*(.*)$",
					"severity": 1,
					"message": 2
				}
			}
		}
	]
}